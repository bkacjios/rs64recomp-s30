# PocketGo S30: ARMv7 hard-float, Alpine musl sysroot, through the cfw's clang wrappers.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR armv7l)
get_filename_component(S30_WORK "${CMAKE_CURRENT_LIST_DIR}/../../../s30-build" ABSOLUTE)
set(S30_WORK "${S30_WORK}" CACHE PATH "pocketgo-s30 build tree (sysroot + armv7-clang wrappers)")
set(CMAKE_C_COMPILER "${S30_WORK}/bin/armv7-clang")
set(CMAKE_CXX_COMPILER "${S30_WORK}/bin/armv7-clang++")
set(CMAKE_SYSROOT "${S30_WORK}/sysroot")
set(CMAKE_FIND_ROOT_PATH "${S30_WORK}/sysroot")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_C_FLAGS_INIT "-mtune=cortex-a7")
set(CMAKE_CXX_FLAGS_INIT "-mtune=cortex-a7")
