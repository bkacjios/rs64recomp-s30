+static void timeline(const char* what, uint32_t a) {
+    static const bool s_on = [](){ const char* e = std::getenv("S30_TIMELINE"); return e && *e == '1'; }();
+    static const auto s_t0 = std::chrono::steady_clock::now();
+    static std::atomic<int> s_n{0};
